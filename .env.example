# PikPak refresh tokens are single-use: every login rotates them, and the CLI
# writes the replacement back into this file automatically. Keep the token here
# rather than in your shell environment — from the environment the tool can only
# print the replacement, and missing it leaves your copy stale.
#
# Don't let another client refresh the same account at the same time: the web
# app (or a second copy of this tool) will rotate the token first and leave this
# one stale. If that happens, the CLI re-reads this file and retries once.
PIKPAK_REFRESH_TOKEN=your_refresh_token
PIKPAK_PROXY=
PIKPAK_CLIENT_ID=
PIKPAK_CLIENT_SECRET=
